# Bu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env.local hech qachon GitHub'ga yuklanmaydi (.gitignore da).

# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCCdddEEEfff

# Buyurtma xabari boradigan chat(lar). Bir nechta bo'lsa vergul bilan: 11111111,22222222
# Chat ID ni bilish: botga /start yozing, keyin `npm run telegram:setup`
TELEGRAM_CHAT_ID=
